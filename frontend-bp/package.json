{
  "name": "frontend-bp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server/dev.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --runInBand && jest --config jest.server.config.cjs --runInBand",
    "test:coverage": "jest --runInBand --coverage && jest --config jest.server.config.cjs --runInBand --coverage",
    "start:prod": "node server/start.cjs --production",
    "start:middleware": "node server/start.cjs",
    "test:middleware": "jest --config jest.server.config.cjs --runInBand"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  },
  "engines": {
    "npm": ">=11 <12",
    "node": ">=24.19.0 <25"
  }
}
